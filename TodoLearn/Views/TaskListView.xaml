<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             xmlns:models="clr-namespace:TodoLearn.Models"
             x:Class="TodoLearn.Views.TaskListView">
    <Grid x:Name="RootLayout" BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">
    <Grid x:Name="ListLayout" HorizontalOptions="Center" Padding="0,24" RowDefinitions="Auto, Auto, *, Auto" RowSpacing="20" BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="6">
            <Label x:Name="TitleLabel" FontSize="30" FontAttributes="Bold" />
            <Label Grid.Row="1" Text="{Binding TodayText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            <Label Grid.Column="1" Text="{Binding CurrentTimeText}" IsVisible="{Binding IsDashboardVisible}" FontSize="28" HorizontalTextAlignment="End" VerticalOptions="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsDashboardVisible}">
                <Label Text="{Binding CompactNextTaskTitle}" FontSize="12" HorizontalTextAlignment="End" MaxLines="1" LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding CompactNextTaskTitle}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Grid.Column="1" Text="{Binding NextDeadlineRemaining}" IsVisible="{Binding HasNextDeadline}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDeadlineSoon}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource PriorityHighColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Grid>

        <Border x:Name="QuickComposer" Grid.Row="1" Padding="10,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry x:Name="QuickTaskEntry" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}" Completed="OnComposerToggleClicked" ReturnType="Go" BackgroundColor="Transparent" />
                <Button Grid.Column="1" Text="+" Style="{StaticResource PrimaryActionButton}" FontSize="25" WidthRequest="40" HeightRequest="40" Padding="0" VerticalOptions="Center" Clicked="OnComposerToggleClicked" ToolTipProperties.Text="{x:Static strings:AppResources.AddTaskAction}" SemanticProperties.Description="{x:Static strings:AppResources.AddTaskAction}" />
            </Grid>
        </Border>


        <CollectionView x:Name="TaskCollection" Grid.Row="2" ItemsSource="{Binding DisplayTasks}" SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="24,48" Spacing="12" MaximumWidthRequest="360">
                    <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource SurfaceDark}}">
                        <Label Text="✓" FontSize="30" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Border>
                    <Label Text="{x:Static strings:AppResources.EmptyTasksTitle}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static strings:AppResources.EmptyTasksHint}" FontSize="13" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Button Text="{x:Static strings:AppResources.AddTaskAction}" Style="{StaticResource QuietActionButton}" Clicked="OnComposerToggleClicked" HorizontalOptions="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,1" Padding="10,12" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnTaskPointerEntered" PointerExited="OnTaskPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="36, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="6">
                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" CheckedChanged="OnTaskCompletionChanged" VerticalOptions="Start" />

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5" BindingContextChanged="OnTaskSummaryBindingContextChanged">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnTaskDoubleTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Text}" LineBreakMode="WordWrap" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding CategoryName}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" VerticalOptions="Center" />
                                <Label Text="⚑" FontSize="14" VerticalOptions="Center" ToolTipProperties.Text="{Binding PriorityText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Low"><Setter Property="TextColor" Value="{StaticResource PriorityLowColor}" /></DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Medium"><Setter Property="TextColor" Value="{StaticResource PriorityMediumColor}" /></DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="High"><Setter Property="TextColor" Value="{StaticResource PriorityHighColor}" /></DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding CompactDueAtText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Button Grid.Row="0" Grid.Column="2" Text="⋯" Style="{StaticResource QuietActionButton}" FontSize="22" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnTaskMenuClicked" SemanticProperties.Description="{x:Static strings:AppResources.TaskActions}" />


                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" ColumnSpacing="8" IsVisible="{Binding HasDescription}">
                            <Label Grid.Column="0" Text="{Binding Description}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" MaxLines="1" SizeChanged="OnDescriptionLabelSizeChanged" PropertyChanged="OnDescriptionLabelPropertyChanged">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDescriptionExpanded}" Value="True">
                                        <Setter Property="MaxLines" Value="-1" />
                                        <Setter Property="LineBreakMode" Value="WordWrap" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding ExpandToggleText}" IsVisible="{Binding ShowDescriptionToggle}" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDescriptionToggleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>


                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" IsVisible="{Binding HasSteps}">
                            <Button Text="{Binding StepsProgress}" Clicked="OnStepsToggleClicked" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Padding="0" FontSize="12" />
                            <VerticalStackLayout IsVisible="{Binding StepsExpanded}" BindableLayout.ItemsSource="{Binding Steps}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="32,*" ColumnSpacing="6" Padding="0,2">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" CheckedChanged="OnStepCompletionChanged" />
                                            <Label Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center" FontSize="13" LineBreakMode="WordWrap">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <BoxView Grid.Row="3" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,10,0,0" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="ClearCompletedButton" Grid.Row="3" Text="{x:Static strings:AppResources.ClearCompletedButton}" Clicked="OnClearCompletedClicked" HorizontalOptions="End" Style="{StaticResource QuietActionButton}" FontSize="12" />
    </Grid>
        <ContentView x:Name="ComposerHost" ZIndex="10" IsVisible="{Binding IsComposerExpanded}" />

    </Grid>
</ContentView>
