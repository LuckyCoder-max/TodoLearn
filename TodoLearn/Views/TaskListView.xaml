<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             xmlns:models="clr-namespace:TodoLearn.Models"
             x:Class="TodoLearn.Views.TaskListView">
    <Grid Padding="28,20" RowDefinitions="Auto, Auto, *, Auto" RowSpacing="20" BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">
        <VerticalStackLayout Spacing="4">
            <Label x:Name="TitleLabel" FontSize="30" FontAttributes="Bold" />
            <Label Text="{Binding TodayText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <Border x:Name="QuickComposer" Grid.Row="1" Padding="10,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Entry x:Name="QuickTaskEntry" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}" Completed="OnComposerToggleClicked" BackgroundColor="Transparent" />
                <Button Grid.Column="1" Text="{x:Static strings:AppResources.AddButton}" Clicked="OnComposerToggleClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Grid>
        </Border>

        <Grid Grid.RowSpan="4" Margin="-28,-20" Padding="24" ZIndex="10" BackgroundColor="#99000000" IsVisible="{Binding IsComposerExpanded}">
        <Border Padding="24" WidthRequest="480" MaximumWidthRequest="520" MaximumHeightRequest="600" HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <ScrollView>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
                <Label Text="{Binding ComposerTitle}" FontSize="22" FontAttributes="Bold" />
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Entry x:Name="NewTaskEntry" Grid.Column="0" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}" ReturnType="Next" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" PlaceholderColor="{StaticResource Gray500}" />
                </Grid>
                <Editor x:Name="NewTaskDescriptionEditor" Grid.Row="2" IsVisible="{Binding IsComposerExpanded}" Placeholder="{x:Static strings:AppResources.DescriptionPlaceholder}" HeightRequest="64" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" PlaceholderColor="{StaticResource Gray500}" />
                <Grid Grid.Row="3" IsVisible="{Binding IsComposerExpanded}" ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.PriorityLabel}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    <Picker x:Name="NewTaskPriorityPicker" Grid.Column="1" ItemsSource="{Binding PriorityOptions}" SelectedIndex="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                </Grid>
                <Label Grid.Row="4" IsVisible="{Binding IsComposerExpanded}" Text="{x:Static strings:AppResources.DueLabel}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Grid Grid.Row="5" IsVisible="{Binding IsComposerExpanded}" ColumnDefinitions="*, *" ColumnSpacing="8">
                    <DatePicker x:Name="NewTaskDatePicker" Grid.Column="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    <TimePicker x:Name="NewTaskTimePicker" Grid.Column="1" Format="{x:Static strings:AppResources.TimePickerFormat24Hour}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                </Grid>
                <Grid Grid.Row="6" ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Label Text="{x:Static strings:AppResources.CategoryLabel}" VerticalOptions="Center" />
                    <Picker x:Name="NewTaskCategoryPicker" Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedIndex="0" />
                </Grid>
                <Label x:Name="ValidationLabel" Grid.Row="7" IsVisible="False" TextColor="{StaticResource PriorityHighColor}" FontSize="12" />
                <HorizontalStackLayout Grid.Row="8" Spacing="12" HorizontalOptions="End" Margin="0,8,0,0">
                    <Button Text="{x:Static strings:AppResources.CancelButton}" Clicked="OnComposerToggleClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Button x:Name="CreateTaskButton" Text="{Binding ComposerSaveText}" Clicked="OnAddTaskClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
            </ScrollView>
        </Border>
        </Grid>

        <CollectionView x:Name="TaskCollection" Grid.Row="2" ItemsSource="{Binding DisplayTasks}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="24,48" Spacing="10">
                    <Label Text="{x:Static strings:AppResources.EmptyTasksTitle}" FontSize="20" HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static strings:AppResources.EmptyTasksHint}" FontSize="13" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,1" Padding="6,14" StrokeThickness="0" BackgroundColor="Transparent">
                    <Grid ColumnDefinitions="36, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="6">
                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" CheckedChanged="OnTaskCompletionChanged" VerticalOptions="Start" />

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnTaskDoubleTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Text}" LineBreakMode="WordWrap" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="TextColor" Value="Gray" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding CategoryName}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                <Frame WidthRequest="12" HeightRequest="12" CornerRadius="6" Padding="0" HasShadow="False" VerticalOptions="Center">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="Low">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="Medium">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="High">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighColor}" />
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                                <Label Text="{Binding DueAtText}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4" VerticalOptions="Start">
                            <Button Text="{x:Static strings:AppResources.EditTaskAction}" Clicked="OnTaskDoubleTapped" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Padding="8,4" FontSize="12" />
                            <Button Text="{x:Static strings:AppResources.DeleteButton}" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" Padding="8,4" FontSize="12" />
                        </HorizontalStackLayout>

                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" ColumnSpacing="8" IsVisible="{Binding HasDescription}">
                            <Label Grid.Column="0" Text="{Binding Description}" FontSize="13" TextColor="Gray" LineBreakMode="TailTruncation" MaxLines="1" SizeChanged="OnDescriptionLabelSizeChanged" PropertyChanged="OnDescriptionLabelPropertyChanged">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDescriptionExpanded}" Value="True">
                                        <Setter Property="MaxLines" Value="-1" />
                                        <Setter Property="LineBreakMode" Value="WordWrap" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding ExpandToggleText}" IsVisible="{Binding ShowDescriptionToggle}" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDescriptionToggleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>


                    </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="ClearCompletedButton" Grid.Row="3" Text="{x:Static strings:AppResources.ClearCompletedButton}" Clicked="OnClearCompletedClicked" HorizontalOptions="End" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" FontSize="12" />
    </Grid>
</ContentView>
