<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             xmlns:vm="clr-namespace:TodoLearn.ViewModels"
             xmlns:models="clr-namespace:TodoLearn.Models"
             x:DataType="vm:TaskEditorViewModel" x:Class="TodoLearn.Views.TaskComposerView">
    <Grid Padding="24" ZIndex="10">
        <BoxView x:Name="Scrim" Margin="-24" Color="#99000000" />
        <Border x:Name="Dialog" Padding="24" HorizontalOptions="Center" VerticalOptions="Center"
                Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                StrokeThickness="1" StrokeShape="RoundRectangle 16"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding Heading}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="×" FontSize="22" WidthRequest="40" Padding="0"
                            Style="{StaticResource QuietActionButton}" Clicked="OnCancelClicked" IsEnabled="{Binding CanInteract}"
                            ToolTipProperties.Text="{x:Static strings:AppResources.CloseTaskForm}"
                            SemanticProperties.Description="{x:Static strings:AppResources.CloseTaskForm}" />
                </Grid>
                <ScrollView x:Name="FieldsScroll" Grid.Row="1" IsEnabled="{Binding CanInteract}">
                    <VerticalStackLayout Spacing="16" Padding="0,0,4,4">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static strings:AppResources.TaskTitleLabel}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Entry x:Name="NewTaskEntry" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}"
                                   Text="{Binding Title, Mode=TwoWay}" ReturnType="Next" Completed="OnTitleCompleted"
                                   SemanticProperties.Description="{x:Static strings:AppResources.TaskTitleLabel}" />
                            <Label Text="{Binding ValidationError}" IsVisible="{Binding HasValidationError}" FontSize="12"
                                   TextColor="{StaticResource PriorityHighColor}" />
                        </VerticalStackLayout>
                        <Editor x:Name="NewTaskDescriptionEditor" Text="{Binding Description, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.DescriptionPlaceholder}"
                                HeightRequest="80" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                BackgroundColor="Transparent" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{x:Static strings:AppResources.PriorityLabel}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Picker x:Name="NewTaskPriorityPicker" ItemsSource="{Binding PriorityOptions}" SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                        SemanticProperties.Description="{x:Static strings:AppResources.PriorityLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{x:Static strings:AppResources.CategoryLabel}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Picker x:Name="NewTaskCategoryPicker" ItemsSource="{Binding CategoryOptions}" SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                        SemanticProperties.Description="{x:Static strings:AppResources.CategoryLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static strings:AppResources.DueLabel}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <DatePicker Date="{Binding DueDate, Mode=TwoWay}" Format="{x:Static strings:AppResources.DatePickerFormat}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static strings:AppResources.DueTimeLabel}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <TimePicker Time="{Binding DueTime, Mode=TwoWay}" Format="{x:Static strings:AppResources.TimePickerFormat24Hour}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                        SemanticProperties.Description="{x:Static strings:AppResources.DueTimeLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static strings:AppResources.Subtasks}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Steps}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskStep">
                                        <Grid ColumnDefinitions="32,*,40" ColumnSpacing="6">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" />
                                            <Entry Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.StepPlaceholder}" />
                                            <Button Grid.Column="2" Text="×" Padding="0" Style="{StaticResource QuietActionButton}" Clicked="OnRemoveStepClicked"
                                                    SemanticProperties.Description="{x:Static strings:AppResources.RemoveStep}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="StepEntry" Text="{Binding PendingStep, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.StepPlaceholder}" Completed="OnAddStepClicked" />
                                <Button Grid.Column="1" Text="{x:Static strings:AppResources.AddStep}" Style="{StaticResource QuietActionButton}" Clicked="OnAddStepClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="16">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="{x:Static strings:AppResources.SaveShortcutHint}" FontSize="11" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Button Grid.Column="1" Text="{x:Static strings:AppResources.CancelButton}" Style="{StaticResource QuietActionButton}" Clicked="OnCancelClicked" IsEnabled="{Binding CanInteract}" />
                        <Button x:Name="CreateTaskButton" Grid.Column="2" Text="{Binding SaveText}"
                                Style="{StaticResource PrimaryActionButton}" Clicked="OnSaveClicked" IsEnabled="{Binding CanInteract}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
