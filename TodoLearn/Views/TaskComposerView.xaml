<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             x:Name="ComposerRoot" x:Class="TodoLearn.Views.TaskComposerView">
        <Grid Padding="24" ZIndex="10" BackgroundColor="#99000000" IsVisible="{Binding IsComposerExpanded}">
        <Border Padding="24" WidthRequest="480" MaximumWidthRequest="520" MaximumHeightRequest="600" HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <ScrollView>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="12">
                <Label Text="{Binding ComposerTitle}" FontSize="22" FontAttributes="Bold" />
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Entry x:Name="NewTaskEntry" x:FieldModifier="internal" Grid.Column="0" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}" ReturnType="Next" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" PlaceholderColor="{StaticResource Gray500}" />
                </Grid>
                <Editor x:Name="NewTaskDescriptionEditor" x:FieldModifier="internal" Grid.Row="2" IsVisible="{Binding IsComposerExpanded}" Placeholder="{x:Static strings:AppResources.DescriptionPlaceholder}" HeightRequest="64" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" PlaceholderColor="{StaticResource Gray500}" />
                <Grid Grid.Row="3" IsVisible="{Binding IsComposerExpanded}" ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.PriorityLabel}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    <Picker x:Name="NewTaskPriorityPicker" x:FieldModifier="internal" Grid.Column="1" ItemsSource="{Binding PriorityOptions}" SelectedIndex="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                </Grid>
                <Label Grid.Row="4" IsVisible="{Binding IsComposerExpanded}" Text="{x:Static strings:AppResources.DueLabel}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <DatePicker x:Name="NewTaskDatePicker" x:FieldModifier="internal" Format="{x:Static strings:AppResources.DatePickerFormat}" />
                    <Label Grid.Row="1" Text="{x:Static strings:AppResources.DueTimeLabel}" FontSize="13" />
                    <TimePicker x:Name="NewTaskTimePicker" x:FieldModifier="internal" Grid.Row="2" Format="{x:Static strings:AppResources.TimePickerFormat24Hour}" />
                </Grid>
                <Grid Grid.Row="6" ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Label Text="{x:Static strings:AppResources.CategoryLabel}" VerticalOptions="Center" />
                    <Picker x:Name="NewTaskCategoryPicker" x:FieldModifier="internal" Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedIndex="0" />
                </Grid>
                <Label x:Name="ValidationLabel" x:FieldModifier="internal" Grid.Row="7" IsVisible="False" TextColor="{StaticResource PriorityHighColor}" FontSize="12" />
                <HorizontalStackLayout Grid.Row="8" Spacing="12" HorizontalOptions="End" Margin="0,8,0,0">
                    <Button Text="{x:Static strings:AppResources.CancelButton}" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Button x:Name="CreateTaskButton" x:FieldModifier="internal" Text="{Binding ComposerSaveText}" Clicked="OnSaveClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
            </ScrollView>
        </Border>
        </Grid>
</ContentView>
