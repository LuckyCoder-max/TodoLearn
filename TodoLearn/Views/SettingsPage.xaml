<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             x:Class="TodoLearn.Views.SettingsPage"
             Title="{x:Static strings:AppResources.Settings}">
    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="460" HorizontalOptions="Center" Padding="28,40" Spacing="20">
            <Label Text="{x:Static strings:AppResources.Settings}" FontSize="28" FontAttributes="Bold" />
            <Label Text="{x:Static strings:AppResources.Appearance}" FontSize="17" FontAttributes="Bold" />
            <Label Text="{x:Static strings:AppResources.ThemeDescription}" FontSize="13" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            <Border Padding="16" Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <RadioButton x:Name="SystemThemeRadio" GroupName="Theme" Content="{x:Static strings:AppResources.SystemTheme}" Value="System" CheckedChanged="OnThemeChanged" />
                    <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="{x:Static strings:AppResources.LightTheme}" Value="Light" CheckedChanged="OnThemeChanged" />
                    <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="{x:Static strings:AppResources.DarkTheme}" Value="Dark" CheckedChanged="OnThemeChanged" />
                </VerticalStackLayout>
            </Border>
            <Button Text="{x:Static strings:AppResources.Done}" Clicked="OnDoneClicked" HorizontalOptions="End" Padding="24,10" BackgroundColor="{StaticResource Primary}" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
