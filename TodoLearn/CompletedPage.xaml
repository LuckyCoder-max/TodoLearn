<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoLearn.CompletedPage"
             Title="Completed">

    <Grid Padding="16" RowDefinitions="Auto, *, Auto" RowSpacing="10">

        <Label Grid.Row="0"
               Text="Completed tasks"
               FontSize="14"
               TextColor="Gray" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding DisplayTasks}"
                        SelectionMode="None"
                        VerticalOptions="Fill">
            <CollectionView.EmptyView>
                <Label Text="No completed tasks yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="40, *">

                        <Border Grid.Column="0"
                            WidthRequest="24"
                            HeightRequest="24"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Padding="0"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Low">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Medium">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="High">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <Grid Grid.Column="1" ColumnDefinitions="*, Auto, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding Text}"
                                   VerticalOptions="Center"
                                   TextDecorations="Strikethrough"
                                   TextColor="Gray" />

                            <Grid Grid.Column="1" RowDefinitions="Auto, Auto" VerticalOptions="Center" Margin="8,0">
                                <Label Grid.Row="0" Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy HH:mm}'}" FontSize="11" />
                                <Label Grid.Row="1" Text="{Binding DueAt, StringFormat='Due by: {0:MMM d, yyyy HH:mm}'}" FontSize="11" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Text="Delete"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Clear All Completed"
                Clicked="OnClearCompletedClicked"
                HorizontalOptions="End" />
    </Grid>

</ContentPage>
