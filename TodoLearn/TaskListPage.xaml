<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TodoLearn.ViewModels"
             x:Class="TodoLearn.TaskListPage">

    <Grid Padding="16" RowDefinitions="Auto, *, Auto" RowSpacing="10">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="8"
              IsVisible="{Binding CanAddTasks}">
            <Entry Placeholder="Add a task..."
                   Text="{Binding NewTaskText, Mode=TwoWay}"
                   Grid.Column="0"
                   ReturnCommand="{Binding AddTaskCommand}" />
            <Button Text="Add"
                    Grid.Column="1"
                    Command="{Binding AddTaskCommand}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding DisplayTasks}"
                        SelectionMode="None"
                        VerticalOptions="Fill">

            <CollectionView.EmptyView>
                <Label Text="No tasks."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="36, 40, *">


                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                  VerticalOptions="Center">
                            <CheckBox.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.ToggleCompleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </CheckBox.GestureRecognizers>
                        </CheckBox>

                        <Border Grid.Column="1"
                                WidthRequest="24" HeightRequest="24"
                                VerticalOptions="Center" HorizontalOptions="Center"
                                Padding="0" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Low">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Medium">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="High">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <Grid Grid.Column="2" RowDefinitions="Auto, Auto" RowSpacing="6">

                            <Grid ColumnDefinitions="*, Auto, Auto">

                                <Label Grid.Column="0"
                                       Text="{Binding Text}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            NumberOfTapsRequired="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.ToggleEditCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Grid Grid.Column="1" RowDefinitions="Auto, Auto" VerticalOptions="Center" Margin="8,0">
                                    <Label Grid.Row="0"
                                           Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                           FontSize="11" />
                                    <Label Grid.Row="1"
                                           Text="{Binding DueAt, StringFormat='Due: {0:dd.MM.yyyy HH:mm}'}"
                                           FontSize="11" />
                                </Grid>

                                <Button Grid.Column="2"
                                        Text="✕"
                                        WidthRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                          Path=BindingContext.DeleteTaskCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  IsVisible="{Binding IsEditing}"
                                  RowDefinitions="Auto, Auto, Auto"
                                  RowSpacing="10"
                                  Padding="0,10,0,0">

                                <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="Priority:" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Low"
                                            BackgroundColor="{StaticResource PriorityLowColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.SetPriorityCommand}"
                                            CommandParameter="{Binding Id, StringFormat='{0}:0'}" />
                                    <Button Grid.Column="2" Text="Medium"
                                            BackgroundColor="{StaticResource PriorityMediumColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.SetPriorityCommand}"
                                            CommandParameter="{Binding Id, StringFormat='{0}:1'}" />
                                    <Button Grid.Column="3" Text="High"
                                            BackgroundColor="{StaticResource PriorityHighColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.SetPriorityCommand}"
                                            CommandParameter="{Binding Id, StringFormat='{0}:2'}" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="Due:" VerticalOptions="Center" WidthRequest="50" />
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding DueDate, Mode=TwoWay}"
                                                Format="dd.MM.yyyy"
                                                HorizontalOptions="Start" />
                                    <TimePicker Grid.Column="2"
                                                Time="{Binding DueTime, Mode=TwoWay}"
                                                Format="HH:mm"
                                                HorizontalOptions="Start" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                    <Button Grid.Column="1" Text="Save"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.SaveTaskCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2" Text="Cancel"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.CancelEditCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Clear Completed"
                Command="{Binding ClearCompletedCommand}"
                HorizontalOptions="End" />

    </Grid>
</ContentPage>
