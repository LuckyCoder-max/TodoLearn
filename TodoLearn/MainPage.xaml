<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
             x:Class="TodoLearn.MainPage">

    <Grid ColumnDefinitions="220, *">
        <StackLayout Grid.Column="0" Padding="12" Spacing="8">
            <Label Text="{x:Static strings:AppResources.AppName}" FontSize="18" />
            <Button Text="{x:Static strings:AppResources.MyDay}" Clicked="OnFilterClicked" CommandParameter="MyDay" />
            <Button Text="{x:Static strings:AppResources.Important}" Clicked="OnFilterClicked" CommandParameter="Important" />
            <Button Text="{x:Static strings:AppResources.Planned}" Clicked="OnFilterClicked" CommandParameter="Planned" />
            <Button Text="{x:Static strings:AppResources.AllTasks}" Clicked="OnFilterClicked" CommandParameter="All" />
        </StackLayout>

        <Grid Grid.Column="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Text="{x:Static strings:AppResources.MyDay}" FontSize="18" />

            <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Entry x:Name="NewTaskEntry" Placeholder="{x:Static strings:AppResources.AddTaskPlaceholder}" HorizontalOptions="FillAndExpand" />
                <Button Text="{x:Static strings:AppResources.AddButton}" Clicked="OnAddTaskClicked" />
            </StackLayout>

            <CollectionView Grid.Row="2" x:Name="TasksCollectionView" ItemsSource="{Binding DisplayTasks}" SelectionMode="None" VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" WidthRequest="24" HeightRequest="24" CornerRadius="12" HasShadow="False" VerticalOptions="Center" HorizontalOptions="Center">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPriorityTapped" NumberOfTapsRequired="1" />
                                    <PointerGestureRecognizer PointerEntered="OnPriorityPointerEntered" PointerExited="OnPriorityPointerExited" />
                                </Frame.GestureRecognizers>
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="Low">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="Medium">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Frame" Binding="{Binding Priority}" Value="High">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighColor}" />
                                    </DataTrigger>
                                </Frame.Triggers>
                            </Frame>

                            <StackLayout Grid.Column="1" Orientation="Vertical" Padding="0" Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnTaskDoubleTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Label Grid.Column="0" Text="{Binding Text}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                        <Label Text="{Binding CreatedAtText}" VerticalOptions="Center" Margin="8,0" />
                                        <Label Text="{Binding DueAtText}" FontSize="12">
                                        </Label>
                                    </StackLayout>
                                    <Button Grid.Column="2" Text="{x:Static strings:AppResources.DeleteButton}" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" VerticalOptions="Start" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" IsVisible="{Binding HasDescription}">
                                    <Label Grid.Column="0"
                                           Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDescriptionExpanded}" Value="True">
                                                <Setter Property="MaxLines" Value="-1" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="1" Text="{Binding ExpandToggleText}" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="End">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDescriptionToggleTapped" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <StackLayout Orientation="Vertical" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <Entry Text="{Binding Text, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.EditTaskPlaceholder}" />
                                    <Editor Text="{Binding Description, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.DescriptionPlaceholder}" AutoSize="TextChanges" MinimumHeightRequest="60" />
                                    <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                                        <Label Text="{x:Static strings:AppResources.PriorityLabel}" VerticalOptions="Center" />
                                        <Button Text="{x:Static strings:AppResources.PriorityLow}" BackgroundColor="{StaticResource PriorityLowColor}" Clicked="OnPrioritySelectClicked" CommandParameter="0" />
                                        <Button Text="{x:Static strings:AppResources.PriorityMedium}" BackgroundColor="{StaticResource PriorityMediumColor}" Clicked="OnPrioritySelectClicked" CommandParameter="1" />
                                        <Button Text="{x:Static strings:AppResources.PriorityHigh}" BackgroundColor="{StaticResource PriorityHighColor}" Clicked="OnPrioritySelectClicked" CommandParameter="2" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="{x:Static strings:AppResources.DueLabel}" VerticalOptions="Center" />
                                        <DatePicker Date="{Binding DueDate, Mode=TwoWay}" />
                                        <TimePicker Time="{Binding DueTime, Mode=TwoWay}" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="End">
                                        <Button Text="{x:Static strings:AppResources.SaveButton}" Clicked="OnSaveClicked" />
                                        <Button Text="{x:Static strings:AppResources.CancelButton}" Clicked="OnCancelClicked" />
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="3" Text="{x:Static strings:AppResources.ClearButton}" Clicked="OnClearCompletedClicked" HorizontalOptions="End" />
        </Grid>
    </Grid>

</ContentPage>
