<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TodoLearn.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TodoLearn"
    xmlns:strings="clr-namespace:TodoLearn.Resources.Strings"
    Shell.NavBarIsVisible="False"
    FlyoutWidth="240"
    FlyoutBackgroundColor="{AppThemeBinding Light=#EAF0F5, Dark=#1E2A32}"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
    Shell.FlyoutBehavior="Locked">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="24,28,20,20" Spacing="6">
            <Label Text="{x:Static strings:AppResources.AppName}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Label Text="{x:Static strings:AppResources.TaskListTitle}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutContent>
        <ScrollView>
            <VerticalStackLayout x:Name="NavigationItems" Padding="12,0" Spacing="4" />
        </ScrollView>
    </Shell.FlyoutContent>

    <Shell.FlyoutFooter>
        <Border Margin="16,8,16,16"
                Padding="14,12"
                StrokeThickness="0"
                Background="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="CurrentUsernameLabel"
                       FontSize="15"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" VerticalOptions="Center" />
                <Button x:Name="SettingsButton" Grid.Column="1" Text="⚙" FontSize="22" WidthRequest="36" HeightRequest="36" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" Clicked="OnSettingsClicked" ToolTipProperties.Text="{x:Static strings:AppResources.Settings}" SemanticProperties.Description="{x:Static strings:AppResources.Settings}" />
                </Grid>
                <Button Text="{x:Static strings:AppResources.LogoutButton}"
                        Clicked="OnLogoutClicked"
                        Margin="0"
                        Padding="12,8"
                        CornerRadius="8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="{x:Static strings:AppResources.MyDay}">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MyDay" />
    </FlyoutItem>

    <FlyoutItem Title="{x:Static strings:AppResources.Important}">
        <ShellContent ContentTemplate="{DataTemplate local:ImportantPage}" Route="Important" />
    </FlyoutItem>

    <FlyoutItem Title="{x:Static strings:AppResources.Planned}">
        <ShellContent ContentTemplate="{DataTemplate local:PlannedPage}" Route="Planned" />
    </FlyoutItem>

    <FlyoutItem Title="{x:Static strings:AppResources.AllTasks}">
        <ShellContent ContentTemplate="{DataTemplate local:AllTasksPage}" Route="AllTasks" />
    </FlyoutItem>

</Shell>
