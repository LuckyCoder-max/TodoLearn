<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Compile Include="../../TodoLearn/AppDbContext.cs" Link="Application/AppDbContext.cs" />
    <Compile Include="../../TodoLearn/Models/*.cs" Exclude="../../TodoLearn/Models/User.cs" Link="Application/Models/%(Filename)%(Extension)" />
    <Compile Include="../../TodoLearn/Helpers/*Validator.cs" Link="Application/Helpers/%(Filename)%(Extension)" />
    <Compile Include="../../TodoLearn/Helpers/TaskQuery.cs" Link="Application/Helpers/TaskQuery.cs" />
    <Compile Include="../../TodoLearn/Services/AuthService.cs;../../TodoLearn/Services/PasswordHasher.cs;../../TodoLearn/Services/TaskService.cs;../../TodoLearn/Services/IAccountSession.cs" Link="Application/Services/%(Filename)%(Extension)" />
    <Compile Include="../../TodoLearn/Resources/Strings/AppResources.cs" Link="Application/AppResources.cs" />
    <EmbeddedResource Include="../../TodoLearn/Resources/Strings/AppResources.resx" LogicalName="TodoLearn.Resources.Strings.AppResources.resources" />
  </ItemGroup>
</Project>
